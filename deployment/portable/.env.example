# Template only. install.ps1/configure.ps1 generate fresh secrets; never copy validation.env.
COMPOSE_PROJECT_NAME=intelligent-vms
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=vms_admin
POSTGRES_DB=intelligent_vms
POSTGRES_PASSWORD=
VMS_OPERATOR_USERNAME=admin
VMS_OPERATOR_PASSWORD=
VMS_SESSION_SECRET=
MEDIAMTX_API_PASSWORD=
MEDIAMTX_MEDIA_PASSWORD=
VMS_MEDIA_AUTH=
VMS_CAMERA_NETWORKS=192.168.1.0/24
VMS_TLS_DIRECTORY=./tls
VMS_PUBLIC_HOST=localhost
VMS_BIND_ADDRESS=127.0.0.1
VMS_HTTPS_PORT=8443
VMS_MAX_RECORDERS=60
VMS_MAX_ADMITTED_CAMERAS=60
VMS_RESOURCE_BLOCK=85
# All CPU/memory/recorder limits remain configurable in compose.production.yml.
