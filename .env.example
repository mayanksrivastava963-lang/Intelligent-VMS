APP_NAME=Intelligent-VMS
APP_ENV=development
APP_DEBUG=true

# Database (PostgreSQL; use POSTGRES_HOST=postgres with compose.bundled-db.yml)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=intelligent_vms
POSTGRES_USER=vms_admin
POSTGRES_PASSWORD=CHANGE_ME

# Redis / Valkey (use compose.valkey.yml for BSD-3-Clause Valkey)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_URL=redis://127.0.0.1:6379/0
VMS_TRUSTED_PROXY_CIDRS=

# MediaMTX streaming & authentication
RTSP_PORT=8554
HLS_PORT=8888
WEBRTC_PORT=8889
WEBRTC_UDP_PORT=8189
MEDIAMTX_API_PASSWORD=
MEDIAMTX_MEDIA_PASSWORD=
VMS_MEDIA_AUTH=
VMS_PUBLIC_HOST=127.0.0.1

# Worker scaling & resource thresholds (defaults are configurable, not hardware ceilings)
VMS_API_WORKERS=2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
VMS_MAX_RECORDERS=16
VMS_MAX_ADMITTED_CAMERAS=16
VMS_RECORDER_ID=primary
VMS_RECORDER_MODE=single
RECORDER_SHARD_INDEX=0
RECORDER_SHARD_TOTAL=1
RECORDER_TAKEOVER_SECONDS=30
VMS_RESOURCE_WARN=75
VMS_RESOURCE_REDUCE=80
VMS_RESOURCE_BLOCK=85
VMS_RESOURCE_HYSTERESIS=3

# Recording & retention
RECORDING_SEGMENT_SECONDS=1800
RECORDING_STORAGE_PATH=./storage/recordings
RECORDING_RETENTION_DAYS=30
RETENTION_FREE_HIGH_BYTES=11811160064
RETENTION_CYCLE_SECONDS=3600
RTSP_RECORD_AUDIO_MODE=aac
MAX_UPLOAD_BYTES=21474836480
MIN_FREE_BYTES=1073741824
FFMPEG_THREADS=2

# Optional AI analytics worker (--profile ai)
VMS_AI_AVAILABLE=false
AI_DEVICE=cpu
AI_GPU_MEMORY_FRACTION=0.5
AI_SAMPLE_INTERVAL_MS=2000
AI_BATCH_SIZE=4
AI_MAX_CAMERAS=4
UNATTENDED_DISTANCE_PIXELS=80
# AI_INTRUSION_ZONES={"camera-uuid":[[20,20],[300,20],[300,200],[20,200]]}
LOITERING_THRESHOLD_SECONDS=1800
UNATTENDED_OBJECT_THRESHOLD_SECONDS=1800

# Security (set strong values before starting; never commit real secrets)
VMS_OPERATOR_USERNAME=admin
VMS_OPERATOR_PASSWORD=
# Optional precomputed Argon2id hash (takes precedence over VMS_OPERATOR_PASSWORD)
VMS_OPERATOR_PASSWORD_HASH=
VMS_SESSION_SECRET=
# Set true behind an HTTPS reverse proxy; false is only for local HTTP development
VMS_SECURE_COOKIE=false
# Authorized literal camera-IP networks, comma separated (empty denies new sources)
VMS_CAMERA_NETWORKS=
