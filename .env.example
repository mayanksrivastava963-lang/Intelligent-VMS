APP_NAME=Intelligent-VMS
APP_ENV=development
APP_DEBUG=true

POSTGRES_HOST=127.0.0.1
POSTGRES_DB=Intelligent-VMS
POSTGRES_USER=vms_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_URL=redis://127.0.0.1:6379/0
VMS_TRUSTED_PROXY_CIDRS=

RTSP_PORT=8554
HLS_PORT=8888
WEBRTC_PORT=8889
WEBRTC_UDP_PORT=8189
MEDIAMTX_API_PASSWORD=
VMS_PUBLIC_HOST=127.0.0.1
VMS_API_WORKERS=4
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
RECORDING_RETENTION_DAYS=30
RETENTION_FREE_HIGH_BYTES=11811160064

RECORDING_SEGMENT_SECONDS=1800
RECORDING_STORAGE_PATH=./storage/recordings
EXPORT_STORAGE_PATH=./storage/exports

AI_SAMPLE_INTERVAL_MS=2000
AI_BATCH_SIZE=4
AI_MAX_CAMERAS=4
UNATTENDED_DISTANCE_PIXELS=80
# AI_INTRUSION_ZONES={"camera-uuid":[[20,20],[300,20],[300,200],[20,200]]}
LOITERING_THRESHOLD_SECONDS=1800
UNATTENDED_OBJECT_THRESHOLD_SECONDS=1800

# Recording workspace: set these before Docker deployment; never commit real values.
VMS_OPERATOR_USERNAME=admin
VMS_OPERATOR_PASSWORD=
# Optional precomputed Argon2id hash. If set, it takes precedence over the password.
VMS_OPERATOR_PASSWORD_HASH=
VMS_SESSION_SECRET=
# Set true behind an HTTPS reverse proxy; false is only for local HTTP development.
VMS_SECURE_COOKIE=false
MAX_UPLOAD_BYTES=21474836480
MIN_FREE_BYTES=1073741824
FFMPEG_THREADS=2
# Optional local override. Without DATABASE_URL, local startup uses storage/recordings.db.
# DATABASE_URL=postgresql+psycopg://user:URL_ENCODED_PASSWORD@127.0.0.1:5432/intelligent_vms
